# Copy this file to `.env` and fill with real values. Do NOT commit `.env`.
# Example:
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# SECRET_KEY=a-long-random-secret-for-flask
# APPS_SCRIPT_URL=https://script.google.com/macros/s/your-script-id/exec
# SECRET_TOKEN=some-internal-secret-token

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SECRET_KEY=
APPS_SCRIPT_URL=
SECRET_TOKEN=

# Optional: override spreadsheet IDs here if you do not want to use the defaults
SPREADSHEET_SEKRETARIAT=
SPREADSHEET_PEMDES=
SPREADSHEET_BIDANG2=
SPREADSHEET_BIDANG3=
SPREADSHEET_BIDANG4=
# .env.example
# Salin file ini menjadi .env lalu isi nilainya
# JANGAN commit file .env ke GitHub

# Google OAuth (dari Google Cloud Console)
GOOGLE_CLIENT_ID=ISI_CLIENT_ID_DISINI
GOOGLE_CLIENT_SECRET=ISI_CLIENT_SECRET_DISINI

# Secret key untuk enkripsi session (buat string acak panjang, minimal 32 karakter)
SECRET_KEY=buat-string-acak-panjang-dan-simpan-aman

# Apps Script (URL deployment setelah deploy sebagai Web App)
APPS_SCRIPT_URL=ISI_URL_APPS_SCRIPT_DISINI
SECRET_TOKEN=buat-token-rahasia-yang-sama-dengan-di-AppsScript
